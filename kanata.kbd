(defcfg
  process-unmapped-keys yes
)

(defsrc
  esc  caps a s d f h j k l ;
)

(defvar
  tap-time 200
  hold-time 200
)

(defalias
  ;; Caps ↔ Esc swap
  esc-to-caps (tap-hold $tap-time $tap-time caps caps)
  caps-to-esc esc

  esc-nav (tap-hold $tap-time $tap-time esc (layer-while-held nav))

  ;; Home-row mods
  a (tap-hold $tap-time $hold-time a lctl)
  s (tap-hold $tap-time $hold-time s lalt)
  d (tap-hold $tap-time $hold-time d lmet)
  f (tap-hold $tap-time $hold-time f lsft)

  j (tap-hold $tap-time $hold-time j rsft)
  k (tap-hold $tap-time $hold-time k rmet)
  l (tap-hold $tap-time $hold-time l ralt)
  ; (tap-hold $tap-time $hold-time ; rctl)

)

(deflayer base
   @esc-to-caps @esc-nav @a @s @d @f h @j @k @l @;
)

(deflayer nav
    _    _    _ _ _ _ left down up right _
)