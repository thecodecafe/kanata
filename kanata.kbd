(defcfg
  process-unmapped-keys yes
)

(defsrc
  esc f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
  caps a s d f h j k l ;
  fn spc
)

(defvar
  tap-time 200
  hold-time 200
)

(defalias
  ;; Caps ↔ Esc swap
  esc-to-caps (tap-hold $tap-time $tap-time caps caps)
  caps-to-esc esc

  esc-nav (tap-hold $tap-time $tap-time esc (layer-while-held nav))

  fnly (tap-hold $tap-time $tap-time fn (layer-while-held function))

  msly (tap-hold $tap-time $tap-time spc (layer-while-held mouse))

  ;; Mouse movements
  msu (movemouse-up 4 2)
  msd (movemouse-down 4 2) 
  msl (movemouse-left 4 2)
  msr (movemouse-right 4 2)

  ;; Home-row mods
  a (tap-hold $tap-time $hold-time a lctl)
  s (tap-hold $tap-time $hold-time s lalt)
  d (tap-hold $tap-time $hold-time d lmet)
  f (tap-hold $tap-time $hold-time f lsft)

  j (tap-hold $tap-time $hold-time j rsft)
  k (tap-hold $tap-time $hold-time k rmet)
  l (tap-hold $tap-time $hold-time l ralt)
  ; (tap-hold $tap-time $hold-time ; rctl)

)

(deflayer base
  @esc-to-caps f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
  @esc-nav @a @s @d @f h @j @k @l @;
  @fnly @msly
)

(deflayer nav
  _   _  _  _  _  _  _  _  _  _  _   _   _
  _    _ _ _ _ left down up right _
  _  _
)

(deflayer mouse
  _   _  _  _  _  _  _  _  _  _  _   _   _
  _    _ _ mrgt mlft @msl @msd @msu @msr _
  _  _
)

(deflayer function
  _   brdn brup C-up M-spc _  dnd prev pp next mute vold volu
  _    _ _ _ _ _ _ _ _ _
  _  _
)